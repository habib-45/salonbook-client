# Public origin used for metadata and future payment redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reserved for the Express API integration.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Reserved for ImgBB image uploads once the API proxies them.
NEXT_PUBLIC_IMGBB_API_KEY=

# Reserved for Stripe Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Reserved demo messaging toggle.
NEXT_PUBLIC_DEMO_MODE=true
